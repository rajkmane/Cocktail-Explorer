<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Cocktail Explorer</title>

    <link rel="stylesheet" href="/styles.css">
</head>

<body>

    <div class="container">

        <h1>🍹 Cocktail Explorer</h1>

        <p>Discover cocktails, ingredients and recipes.</p>

        <form action="/search" method="GET">

            <input
                type="text"
                name="name"
                placeholder="Enter cocktail name..."
                required
            >

            <button type="submit">
                Search
            </button>

        </form>

        <a href="/random" class="random-btn">
            🎲 Get Random Cocktail
        </a>

        <% if (typeof error !== "undefined") { %>
            <div class="error">
                <%= error %>
            </div>
        <% } %>

    </div>

</body>
</html>